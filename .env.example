# Supabase — https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Edge Functions only ────────────────────────────────────────────────────────
# Set these in Supabase Dashboard → Settings → Edge Functions → Secrets,
# NOT in this file (they are server-side secrets).

# notify-rsvp: email delivery via Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# notify-rsvp: shared secret used to verify the webhook caller is trusted.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=a-random-secret-string

# notify-rsvp: production URL shown in the "Lihat Semua RSVP" email button.
SITE_URL=https://andifila.github.io/hadirku

# submit-rsvp / notify-rsvp: auto-injected by Supabase runtime — do NOT set manually.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
